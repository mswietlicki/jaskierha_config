[
  {
    "id": "1787035861878",
    "alias": "Jaskier Trip - Capture Start",
    "description": "Capture the OBD odometer, time, and EWD108 position when Jaskier's engine starts. This baseline drives the current-trip distance and the completed trip record.",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "binary_sensor.jaskier_wican_obd_pro_engine_on",
        "from": "off",
        "to": "on",
        "id": "engine_started"
      }
    ],
    "conditions": [
      {
        "condition": "state",
        "entity_id": "binary_sensor.jaskier_wican_obd_pro_engine_on",
        "state": "on"
      },
      {
        "condition": "not",
        "conditions": [
          {
            "condition": "state",
            "entity_id": "sensor.jaskier_wican_obd_pro_31_distancesincecodeclear",
            "state": [
              "unknown",
              "unavailable"
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "variables": {
          "start_location": "{% if has_value('device_tracker.jaskier_gps') %}{{ state_attr('device_tracker.jaskier_gps', 'latitude') }},{{ state_attr('device_tracker.jaskier_gps', 'longitude') }}{% else %}Unknown{% endif %}"
        }
      },
      {
        "action": "input_number.set_value",
        "target": {
          "entity_id": "input_number.jaskier_trip_start_odometer"
        },
        "data": {
          "value": "{{ states('sensor.jaskier_wican_obd_pro_31_distancesincecodeclear') | float }}"
        }
      },
      {
        "action": "input_datetime.set_datetime",
        "target": {
          "entity_id": "input_datetime.jaskier_trip_started_at"
        },
        "data": {
          "datetime": "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"
        }
      },
      {
        "action": "input_text.set_value",
        "target": {
          "entity_id": "input_text.jaskier_trip_start_location"
        },
        "data": {
          "value": "{{ start_location }}"
        }
      }
    ],
    "mode": "restart"
  },
  {
    "id": "1787035862435",
    "alias": "Jaskier Trip - Record End",
    "description": "At engine-off, pulse the completed distance for history graphs and add a dated trip with EWD108 endpoints to the Jaskier Trips calendar.",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "binary_sensor.jaskier_wican_obd_pro_engine_on",
        "from": "on",
        "to": "off",
        "id": "engine_stopped"
      }
    ],
    "conditions": [
      {
        "condition": "not",
        "conditions": [
          {
            "condition": "state",
            "entity_id": "sensor.jaskier_wican_obd_pro_31_distancesincecodeclear",
            "state": [
              "unknown",
              "unavailable"
            ]
          }
        ]
      },
      {
        "condition": "numeric_state",
        "entity_id": "input_number.jaskier_trip_start_odometer",
        "above": 0
      }
    ],
    "actions": [
      {
        "variables": {
          "start_odometer": "{{ states('input_number.jaskier_trip_start_odometer') | float(0) }}",
          "end_odometer": "{{ states('sensor.jaskier_wican_obd_pro_31_distancesincecodeclear') | float(0) }}",
          "trip_distance": "{{ ([end_odometer - start_odometer, 0] | max) | round(1) }}",
          "start_time": "{{ states('input_datetime.jaskier_trip_started_at') }}",
          "end_time": "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}",
          "start_location": "{{ states('input_text.jaskier_trip_start_location') }}",
          "end_location": "{% if has_value('device_tracker.jaskier_gps') %}{{ state_attr('device_tracker.jaskier_gps', 'latitude') }},{{ state_attr('device_tracker.jaskier_gps', 'longitude') }}{% else %}Unknown{% endif %}"
        }
      },
      {
        "condition": "template",
        "value_template": "{{ trip_distance | float(0) >= 0.1 }}"
      },
      {
        "action": "input_number.set_value",
        "target": {
          "entity_id": "input_number.jaskier_completed_trip_pulse"
        },
        "data": {
          "value": "{{ trip_distance }}"
        }
      },
      {
        "action": "calendar.create_event",
        "target": {
          "entity_id": "calendar.jaskier_trips"
        },
        "data": {
          "summary": "Jaskier trip — {{ trip_distance }} km",
          "start_date_time": "{{ start_time }}",
          "end_date_time": "{{ end_time }}",
          "location": "{{ end_location }}",
          "description": "Distance: {{ trip_distance }} km\nStart: {{ start_location }}\nEnd: {{ end_location }}\nRoute: https://www.google.com/maps/dir/?api=1&origin={{ start_location }}&destination={{ end_location }}"
        }
      },
      {
        "delay": {
          "minutes": 1
        }
      },
      {
        "action": "input_number.set_value",
        "target": {
          "entity_id": "input_number.jaskier_completed_trip_pulse"
        },
        "data": {
          "value": 0
        }
      }
    ],
    "mode": "queued",
    "max": 5
  },
  {
    "id": "update_ha_location_from_ewd108",
    "alias": "Update Home Assistant Location from EWD108",
    "triggers": [
      {
        "minutes": "/5",
        "trigger": "time_pattern"
      }
    ],
    "conditions": [
      {
        "condition": "not",
        "conditions": [
          {
            "condition": "state",
            "entity_id": "device_tracker.jaskier_gps",
            "state": [
              "unknown",
              "unavailable"
            ]
          }
        ]
      },
      {
        "condition": "numeric_state",
        "entity_id": "device_tracker.jaskier_gps",
        "attribute": "latitude",
        "above": -90,
        "below": 90
      },
      {
        "condition": "numeric_state",
        "entity_id": "device_tracker.jaskier_gps",
        "attribute": "longitude",
        "above": -180,
        "below": 180
      },
      {
        "condition": "not",
        "conditions": [
          {
            "condition": "zone",
            "entity_id": "device_tracker.jaskier_gps",
            "zone": "zone.home"
          }
        ]
      }
    ],
    "actions": [
      {
        "action": "homeassistant.set_location",
        "data": {
          "latitude": "{{ state_attr('device_tracker.jaskier_gps', 'latitude') | float }}",
          "longitude": "{{ state_attr('device_tracker.jaskier_gps', 'longitude') | float }}"
        }
      }
    ],
    "mode": "single"
  }
]
