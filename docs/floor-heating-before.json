{
  "automations": [
    {
      "success": true,
      "action": "get",
      "automation_id": "automation.floor_heating_auto_disable_without_ac_input",
      "config": {
        "id": "floorheating_auto_off_without_ac_input",
        "alias": "Floor Heating - Auto Disable Without AC Input",
        "description": "Turn off floor heating after 5 minutes unless the inverter reports an active AC input.",
        "triggers": [
          {
            "trigger": "state",
            "entity_id": [
              "switch.floorheating"
            ],
            "to": "on",
            "for": {
              "minutes": 5
            }
          }
        ],
        "conditions": [
          {
            "condition": "state",
            "entity_id": "switch.floorheating",
            "state": "on"
          },
          {
            "condition": "numeric_state",
            "entity_id": "sensor.inverter_input_power_l1",
            "below": 500
          }
        ],
        "actions": [
          {
            "action": "switch.turn_off",
            "target": {
              "entity_id": "switch.floorheating"
            }
          }
        ],
        "mode": "single"
      },
      "config_hash": "e085986e9c014ef5"
    },
    {
      "success": true,
      "action": "get",
      "automation_id": "automation.floor_heating_disable_on_inactive_ac_input",
      "config": {
        "id": "floorheating_turn_off_when_ac_input_inactive",
        "alias": "Floor Heating - Disable On Inactive AC Input",
        "description": "Turn off floor heating when the inverter AC input becomes inactive.",
        "triggers": [
          {
            "trigger": "state",
            "entity_id": [
              "sensor.inverter_active_ac_input"
            ]
          }
        ],
        "conditions": [
          {
            "condition": "state",
            "entity_id": "switch.floorheating",
            "state": "on"
          },
          {
            "condition": "template",
            "value_template": "{% set ac_input = trigger.to_state.state | lower | trim %} {% set inactive = ['0', 'off', 'none', 'disconnected', 'not available', 'unknown', 'unavailable', 'false', 'no input'] %} {{ ac_input in inactive or ac_input.startswith('no ') }}\n"
          }
        ],
        "actions": [
          {
            "action": "switch.turn_off",
            "target": {
              "entity_id": "switch.floorheating"
            }
          }
        ],
        "mode": "single"
      },
      "config_hash": "7e4d3c3bc4b4ba7d"
    }
  ],
